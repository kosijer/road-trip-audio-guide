# --- LLM Provider ---
# Which provider the Narration Engine adapter should use by default.
# One of: anthropic | openai | gemini
LLM_PROVIDER=gemini

# Only the key matching LLM_PROVIDER above needs a real value.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Prefer a lite model; gemini-flash-latest is often overloaded (503).
GEMINI_MODEL=gemini-flash-lite-latest

# --- Google Maps Platform ---
# Same Google Cloud API key, with both Places API and Directions API enabled.
GOOGLE_MAPS_API_KEY=

# --- Cloudflare Clef (POI decision ranking) ---
# Opt-in decision model that re-ranks nearby places before narration.
# Without these, the app keeps using the local keyword heuristic.
# Docs: https://developers.cloudflare.com/ai/models/@cf/cloudflare/clef/
CLEF_ENABLED=false
# Dashboard → Workers & Pages / overview → Account ID
CLOUDFLARE_ACCOUNT_ID=
# API Tokens → Create Token → permission "Workers AI:Edit" (or Account.Workers AI)
CLOUDFLARE_API_TOKEN=

# --- Tunables (safe defaults, override if needed) ---
# Driving mode: how often (minutes) to check for new nearby POIs while moving
DRIVING_TRIGGER_INTERVAL_MIN=3

# Driving mode: minimum sustained speed (km/h) to count as "driving"
DRIVING_SPEED_THRESHOLD_KMH=25

# Driving mode: search radius (meters) around each corridor sample point
DRIVING_POI_RADIUS_M=5000

# Walking mode: search radius (meters) for "what's around me"
WALKING_POI_RADIUS_M=800

# Cost guardrail: max LLM narration calls allowed per trip
MAX_LLM_CALLS_PER_TRIP=30
